# Google Cloud で作成した OAuth クライアント ID(ウェブアプリケーション)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 認証方式(省略時は popup)
#   popup    : Google Identity Services のトークンモデル(ポップアップ)
#   auto     : ホーム画面から起動したときだけリダイレクト方式、それ以外はポップアップ
#   redirect : 常にリダイレクト方式(承認済みのリダイレクト URI の登録が必要)
# VITE_AUTH_MODE=popup
